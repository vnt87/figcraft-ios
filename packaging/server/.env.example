# Copy to .env in this folder (next to docker-compose.yml) and edit it. .env is not committed.

# The address your devices use to reach this server. Include the scheme and a trailing slash:
#   ws://192.168.1.20:47900/        on your LAN, or over a tailnet (MagicDNS name or 100.x address)
#   wss://files.example.com/        behind a TLS tunnel or proxy
# Required: compose stops with an error if it is empty.
FIGCRAFT_PUBLIC_URL=ws://192.168.1.20:47900/

# Port on the host, and the host address to publish it on.
#   0.0.0.0    every interface (LAN and tailnet)
#   127.0.0.1  this machine only (for a tunnel that runs on the same host)
FIGCRAFT_PORT=47900
FIGCRAFT_BIND=0.0.0.0

# Host folder that holds the files and the server key. Create it before the first start and make
# it writable by the uid:gid below, for example: mkdir -p data && sudo chown 65532:65532 data
# If you would rather own it yourself, use your own uid and gid here (id -u, id -g).
FIGCRAFT_DATA=./data
FIGCRAFT_UID=65532
FIGCRAFT_GID=65532
